{
  "name": "grovekeeper",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "terminal": "node --env-file-if-exists=.env --import tsx src/index.ts --terminal",
